<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <Target Name="BuildFrontend" BeforeTargets="ComputeFilesToPublish">
    <Exec Condition="'$(SkipFrontendBuild)' != 'true'" WorkingDirectory="$(MSBuildProjectDirectory)\..\..\frontend" Command="npm ci" />
    <Exec Condition="'$(SkipFrontendBuild)' != 'true'" WorkingDirectory="$(MSBuildProjectDirectory)\..\..\frontend" Command="npm run build" />
    <ItemGroup>
      <FrontendFiles Include="$(MSBuildProjectDirectory)\..\..\frontend\dist\**\*" />
      <ResolvedFileToPublish Include="@(FrontendFiles)" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
